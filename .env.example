# API Config
PROJECT_NAME="QNSC Knowledge Base"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/qnsc_kb"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI & LLM
GEMINI_API_KEY="paste-your-google-ai-studio-key-here"
GEMINI_MODEL="gemma-4-26b-a4b-it"
GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_THINKING_LEVEL="minimal"
GEMINI_MAX_OUTPUT_TOKENS="8192"
LLM_TIMEOUT_SECONDS="90"
# Legacy fallback providers (optional)
OPENAI_API_KEY=""
GROQ_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
LLM_MODEL="gemma-4-26b-a4b-it"
RESTRUCTURE_ENABLED="true"
RESTRUCTURE_MODEL=""
RESTRUCTURE_MAX_CHARS="60000"
RESTRUCTURE_TIMEOUT_SECONDS="120"
PADDLEOCR_LANG="en"
MARKITDOWN_ENABLED="true"
SOURCE_STORAGE_PATH="/app/storage/sources"
VECTOR_DISTANCE_THRESHOLD="0.45"
PROMPT_VERSION="v1.0"
RETRIEVAL_VERSION="v1.1-hybrid-rerank"
RERANKER_VERSION="v1.0-lexical"
OIDC_ISSUER_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:5173/auth/callback"
OIDC_SCOPES="openid profile email"
